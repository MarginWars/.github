{
  // Same style as MarginWars/themarginwars.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD029": false,
    "MD033": { "allowed_elements": ["picture", "source", "img", "p", "a", "br"] },
    "MD041": false,
    "MD036": false
  },
  "globs": ["**/*.md"],
  "ignores": [".git/**"]
}
